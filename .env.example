# ============================================================
# AI-DrainOS Environment Configuration Example
# Copy to .env (root) for Docker Compose, or to server/.env
# for local development. NEVER commit real secrets.
# ============================================================

# PostgreSQL Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ai_drainos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin123

# Node Backend Server Configuration
PORT=5000
# Generate a strong secret for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=supersecretkey_change_in_production

# Python AI service URL.
# - Docker Compose: http://ai:5001  (service hostname)
# - Local dev:      http://127.0.0.1:5001
AI_SERVICE_URL=http://ai:5001

# OpenWeatherMap API key (required by /api/weather).
# Get one free at https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Allowed browser origin for Socket.IO CORS.
# - Docker (client on port 80): http://localhost
# - Local dev (Vite):           http://localhost:5173
FRONTEND_URL=http://localhost

# MQTT (IoT sensor) Configuration.
# - Docker Compose service hostname: mqtt://mosquitto:1883
# - Local dev (Mosquitto on your machine): mqtt://localhost:1883
# Leave MQTT_USERNAME / MQTT_PASSWORD empty for a broker with no auth.
MQTT_BROKER_URL=mqtt://mosquitto:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=ai-drainos-backend

# Optional: change the MQTT topic base (default: ai-drainos)
#MQTT_TOPIC_PREFIX=ai-drainos

# Optional: disable MQTT entirely (default: enabled)
#MQTT_ENABLED=true

# Optional: seconds between publish rounds for the MQTT simulator
#MQTT_SIM_INTERVAL=10

# React Frontend Configuration (used at client build time)
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
